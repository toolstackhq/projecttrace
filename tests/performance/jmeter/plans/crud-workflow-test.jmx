            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seedUserEmail" elementType="Argument">
            <stringProp name="Argument.name">seedUserEmail</stringProp>
            <stringProp name="Argument.value">${__P(seedUserEmail,admin@projecttrace.dev)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seedUserPassword" elementType="Argument">
            <stringProp name="Argument.name">seedUserPassword</stringProp>
            <stringProp name="Argument.value">${__P(seedUserPassword,ProjectTrace123!)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
